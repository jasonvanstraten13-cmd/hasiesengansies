# Copy to .env for local testing with `npx netlify dev`, and add the same values
# in Netlify: Site configuration > Environment variables. Never commit real keys.

# Yoco secret key (Yoco portal > Selling Online > Payment Gateway). Use sk_test_ for testing.
YOCO_SECRET_KEY=
# Returned once by `npm run register-webhook`.
YOCO_WEBHOOK_SECRET=
# Public site address, no trailing slash, e.g. https://hasiesengansies.co.za
SITE_URL=http://localhost:8888

# Resend (https://resend.com) for order emails. ORDER_EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
ORDER_EMAIL_FROM=Hasies en Gansies <orders@hasiesengansies.co.za>
ORDER_EMAIL_TO=info@hasiesengansies.co.za
